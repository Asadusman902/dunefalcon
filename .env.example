# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin login ----
ADMIN_PASSWORD=choose-a-strong-password
# any random text, 24+ characters
ADMIN_SESSION_SECRET=

# ---- Email alerts (resend.com → API Keys) ----
RESEND_API_KEY=
# After verifying your domain in Resend, e.g. "Dune Falcon <bookings@dunefalcondubai.com>"
RESEND_FROM=Dune Falcon Bookings <onboarding@resend.dev>
NOTIFY_EMAIL=dunefalcondubai@gmail.com

# ---- WhatsApp alerts (developers.facebook.com → WhatsApp → API Setup) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your personal WhatsApp that receives alerts, digits with country code
NOTIFY_WHATSAPP=971502341729
# Approved template name (see README). Leave empty only for testing.
WHATSAPP_TEMPLATE=new_booking
WHATSAPP_TEMPLATE_LANG=en
